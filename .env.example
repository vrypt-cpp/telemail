# ==========================================================
#  TELEGRAM
#  Token: open @BotFather in Telegram, run /newbot, copy the token
#  Chat ID: your user id for a direct chat. Groups start with -100,
#           for example -1001234567890.
#           You can list several chat ids, separated by commas.
# ==========================================================
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_IDS=987654321

# Only change this when you run a self-hosted Bot API Server.
# Default: https://api.telegram.org
TELEGRAM_API_BASE=https://api.telegram.org

# Minimum delay between messages to the same chat, in ms. Default 1000.
# Only lower it (to about 35000) when you use many chats,
# since a bot may send at most roughly 30 messages per second overall.
TELEGRAM_SEND_INTERVAL_MS=1000

# Maximum length of a single Telegram message (official limit 4096). Default 3800
TELEGRAM_MAX_CHUNK=3800

# How many characters of the email body to show. Default 3000 (0 means no limit)
BODY_PREVIEW_CHARS=3000

# Send notifications without the sound. Default false
TELEGRAM_SILENT=false

# ==========================================================
#  IMAP  (use an app password, NOT your regular password)
#  Gmail    : host imap.gmail.com         port 993  (needs 2FA + app password)
#  Outlook  : host outlook.office365.com  port 993
#  Yahoo    : host imap.mail.yahoo.com    port 993
#  cPanel   : host mail.domain.tld        port 993
# ==========================================================
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=you@gmail.com
IMAP_PASSWORD=xxxxxxxx xxxx xxxx xxxx xxxx xxxx

# Mailbox to watch. Default INBOX
IMAP_MAILBOX=INBOX

# Mark emails as read after they are forwarded to Telegram.
# Default false, so the unread state on your phone is untouched.
# Duplicate protection still works because telemail tracks UIDs,
# not the unread flag.
IMAP_MARK_SEEN=false

# Behaviour on the very first run (while data/state.json does not exist yet):
#   latest = skip every existing email, only forward mail that arrives later
#   all    = also forward all emails already sitting in the mailbox
IMAP_INITIAL_MODE=latest

# Fallback poll interval in ms, used when the server has no IMAP IDLE.
# Default 60000
IMAP_POLL_INTERVAL_MS=60000

# How long the connection may sit idle before IMAP IDLE starts, in ms.
# Default 15000. Lower values deliver mail faster but add server round-trips.
IMAP_AUTO_IDLE_DELAY_MS=15000

# How many emails are processed per batch (each batch holds the mailbox
# lock). Default 10
IMAP_BATCH_SIZE=10

# Set to false only for self-signed certificates, which is less safe.
# Default true
IMAP_TLS_REJECT_UNAUTHORIZED=true

# ==========================================================
#  GENERAL
# ==========================================================
LOG_LEVEL=info
LOG_PRETTY=true
TIMEZONE=Asia/Jakarta
STATE_FILE=./data/state.json
