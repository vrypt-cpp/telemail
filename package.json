{
  "name": "telemail",
  "version": "1.0.0",
  "description": "Forward incoming email to a Telegram bot",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "tsx src/scripts/check.ts",
    "preview": "tsx src/scripts/preview.ts"
  },
  "type": "module",
  "dependencies": {
    "dotenv": "^16.6.1",
    "html-to-text": "^9.0.5",
    "imapflow": "^2.1.0",
    "mailparser": "^3.9.29",
    "pino": "^9.14.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.19.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "license": "MIT",
  "keywords": "email,imap,telegram,bot,automation,forward,imapflow,notification",
  "repository": "https://github.com/vrypt-cpp/telemail",
  "engines": {
    "node": ">=20"
  }
}
